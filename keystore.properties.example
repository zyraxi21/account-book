# 发布签名配置模板
#
# 使用方式：
#   1. 复制本文件为 keystore.properties（该文件不会进版本库）
#   2. 填写下面四项
#   3. 重新构建即可，build.gradle.kts 会自动读取
#
# 注意：口令绝不要提交到 Git。本模板只保留字段名，请勿在此填入真实口令。

# keystore 文件路径。绝对路径或相对项目根目录的路径均可。
storeFile=

# keystore 口令与密钥口令
storePassword=
keyPassword=

# 密钥别名，可用 keytool -list -v -keystore <文件> 查看
keyAlias=